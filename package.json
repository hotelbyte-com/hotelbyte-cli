{
  "name": "hotelbyte-cli",
  "version": "0.2.0",
  "description": "HotelByte CLI — agent-native interface for the OpenAPI and Tenant Portal scenarios",
  "type": "module",
  "bin": {
    "hotelbyte-cli": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/hotelbyte-cli src/cli.ts",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "author": "HotelByte"
}