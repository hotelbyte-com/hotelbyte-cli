{
  "name": "staicli",
  "version": "0.0.4",
  "description": "staicli (hbcli) — HotelByte CLI for hotel search, booking, and tenant management",
  "type": "module",
  "bin": {
    "hbcli": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build:js": "bun build --target=node --outfile=dist/cli.js src/cli.ts",
    "build": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/hbcli src/cli.ts",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build:js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "HotelByte"
}
