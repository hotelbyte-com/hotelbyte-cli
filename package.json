{
  "name": "staicli",
  "version": "0.0.1",
  "description": "staicli (hbcli) — HotelByte CLI for hotel search, booking, and tenant management",
  "type": "module",
  "bin": {
    "hbcli": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile --target=bun-darwin-arm64 --outfile=dist/hbcli src/cli.ts",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "author": "HotelByte"
}